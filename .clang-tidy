---
# Deliberately narrow: correctness and performance, plus two modernisations that
# remove a class of mistake rather than restyling code. No formatting checks:
# that is `make lint`'s job.
# CI passes -warnings-as-errors='*' so this stays empty and clangd does not
# report every finding as an error in the editor.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-use-ranges,
  modernize-use-constraints
  cppcoreguidelines-missing-std-forward
  misc-include-cleaner
  misc-header-include-cycle
  misc-throw-by-value-catch-by-reference
  misc-unconventional-assign-operator
  misc-unused-alias-decls
  misc-unused-using-decls
  misc-use-anonymous-namespace
  misc-use-internal-linkage
  modernize-deprecated-headers
  readability-redundant-inline-specifier
  readability-redundant-declaration
HeaderFilterRegex: 'cpp/arcticdb/.*\.hpp$'
ExcludeHeaderFilterRegex: '.*(vcpkg_installed|third_party|/proto/|_pb2|\.pb\.h).*'
WarningsAsErrors: ''
FormatStyle: file
...
